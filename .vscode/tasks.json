{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build TSP Raylib",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-O2",
        "-Iinclude",
        "-Llib",
        "main.cpp",
        "-o",
        "main.exe",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm",
        "-static",
        "-static-libgcc",
        "-static-libstdc++"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
